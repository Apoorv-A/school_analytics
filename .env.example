# Copy to .env and fill in real values. Never commit .env.

# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLAlchemy URL for the application database.
# Local demo: sqlite:///./school.db
# Production: postgresql+psycopg://user:pass@host:5432/school_analytics
# Use the same URL for uvicorn and: python -m tenant_operator apply --config=...
DATABASE_URL=sqlite:///./school.db

# Default hostname for local uvicorn without editing /etc/hosts (use Host header).
# Tenants are bound to hostnames; local seed uses sunrise.localhost and horizon.localhost.

# Reload templates on change and show verbose errors. Keep false in production.
DEBUG=false

# Require the session cookie to be sent over HTTPS only. Keep true in production.
SESSION_COOKIE_SECURE=false

# Session idle lifetime in seconds (default 8 hours).
SESSION_MAX_AGE=28800

# Show the seeded demo accounts on the login page and let them be prefilled.
# Local evaluation only. Never enable where real accounts exist.
DEMO_MODE=false
DEMO_PASSWORD=

# Percentage at or above which a student is considered to have passed.
PASS_PERCENTAGE=33

# Students below this percentage are flagged as at risk.
AT_RISK_PERCENTAGE=45

# Attendance percentage below which a student is flagged as at risk.
AT_RISK_ATTENDANCE=75

# ERP webhook secrets are referenced from tenant config (erp.webhookSecretRef) and
# resolved at runtime. Local dev example for tenant ref sunrise/erp-webhook:
# SA_SECRET_SUNRISE_ERP_WEBHOOK=

# Webhook replay protection (nonce store). Production requires redis + URL.
# ERP_WEBHOOK_REPLAY_BACKEND=memory
# ERP_WEBHOOK_REPLAY_REDIS_URL=redis://localhost:6379/0

# Login throttling (shared across replicas). Production requires redis + URL.
# LOGIN_THROTTLE_BACKEND=memory
# LOGIN_THROTTLE_REDIS_URL=redis://localhost:6379/1
